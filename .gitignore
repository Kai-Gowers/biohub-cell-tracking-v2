# Competition data (do not commit -- full set is ~90GB).
# No trailing slash: `data` here is a symlink to the sibling repo's data/,
# and a trailing-slash pattern only matches real directories, not symlinks.
data
biohub-cell-tracking-during-development

# Outputs. `dist/*` (not `dist/`) so the held-out split can be un-ignored below;
# git cannot re-include a file under an excluded directory.
submission.csv
dist/*
!dist/heldout_split.json
*.zip

